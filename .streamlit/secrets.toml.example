# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file —
# .gitignore already excludes secrets.toml. On a hosted platform, paste these
# into that platform's secrets/environment UI instead of shipping a file.

# ----------------------------------------------------------------------
# DATABASE  (strongly recommended before launch)
#
# Without this the app writes JSON files to the container's filesystem,
# which most hosts wipe on every redeploy and every restart. That means
# accounts, watchlists and journals silently disappear. Any managed
# Postgres works; the free tiers at Neon and Supabase are enough to start.
# ----------------------------------------------------------------------
DATABASE_URL = "postgresql://user:password@host:5432/dbname?sslmode=require"

# ----------------------------------------------------------------------
# SIGN IN WITH GOOGLE  (optional — omit the whole [auth] block to disable)
#
# Streamlit reads this natively (st.login / st.user). With no [auth]
# block the app shows only the username-and-password form.
#
# To get the values:
#   1. console.cloud.google.com -> new project
#   2. APIs & Services -> OAuth consent screen -> External -> fill in
#      app name, support email, and your domain under Authorised domains
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application
#   4. Authorised redirect URI: https://YOURDOMAIN/oauth2callback
#      (exactly; it must match redirect_uri below character for character)
#   5. Copy the client ID and secret here
#
# While the consent screen is in "Testing" only accounts you list can sign
# in. Publishing it is a form, and is instant unless you request sensitive
# scopes — this app requests only openid/email/profile, which are not.
# ----------------------------------------------------------------------
[auth]
redirect_uri = "https://YOURDOMAIN/oauth2callback"
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, so set it once and keep it.
cookie_secret = "CHANGE-ME-long-random-string"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# SIGN IN WITH APPLE — read the cost note in DEPLOY.md before enabling.
# Apple requires a paid developer account and a client_secret that is a
# signed JWT you must regenerate at least every 6 months, or sign-in
# breaks with no warning. The code path is identical; only this block and
# a rotation reminder are needed.
#
# [auth.apple]
# client_id = "com.yourdomain.tickveil"
# client_secret = "eyJhbGciOiJFUzI1NiIsImtpZCI6..."   # expires — rotate it
# server_metadata_url = "https://appleid.apple.com/.well-known/openid-configuration"

# ----------------------------------------------------------------------
# EMAIL  (for verification codes and password resets)
#
# With a Gmail account you need an App Password, not your login password:
# myaccount.google.com -> Security -> 2-Step Verification (must be on)
# -> App passwords. Gmail's free sending limit is ~500/day, which is fine
# early and is the thing to watch if you grow.
# ----------------------------------------------------------------------
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "abcd efgh ijkl mnop"     # 16-char app password
SMTP_FROM = "Tickveil <you@gmail.com>"

# ----------------------------------------------------------------------
# SUPPORT / DONATIONS  (all optional — each one only renders if set)
# ----------------------------------------------------------------------
# PayNow: generated in-app as a QR. No processor, no fees, no card data.
SUPPORT_PAYNOW_PROXY = "91234567"      # your mobile, or a UEN
SUPPORT_PAYNOW_TYPE  = "mobile"        # "mobile" or "uen"
SUPPORT_PAYNOW_NAME  = "TICKVEIL"      # shown on the QR, max 25 chars

# Cards: a hosted checkout link. The card never touches this app — see
# the reasoning at the top of support.py.
SUPPORT_STRIPE_URL = "https://buy.stripe.com/xxxxxxxx"
SUPPORT_KOFI_URL   = "https://ko-fi.com/yourname"
SUPPORT_BMC_URL    = "https://buymeacoffee.com/yourname"
